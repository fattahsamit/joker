# Copy to .env and fill in. Never commit .env.
# Target environment label, e.g. local | staging | prod
ENV=<environment-name>
# Web app under test
BASE_URL=https://www.saucedemo.com
# API under test
API_URL=https://jsonplaceholder.typicode.com
# Credentials for a valid user (used by the auth setup and the valid-login test)
USERNAME=<your-username>
PASSWORD=<your-password>
# Optional: default timeout for actions and assertions, in milliseconds
TIMEOUT_MS=30000
